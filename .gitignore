# LaTeX byproducts from building an application note in docs/appnotes/sources
docs/appnotes/sources/**/*.aux
docs/appnotes/sources/**/*.log
docs/appnotes/sources/**/*.out
docs/appnotes/sources/**/*.toc
docs/appnotes/sources/**/*.pdf
# An annex is not a byproduct. It is a PDF nothing here can rebuild, appended to the note by the Crop
# target, so it is kept with its note source and tracked.
!docs/appnotes/sources/**/*-annex.pdf
# A PDF made from a GENERATED .ltx beside it is a reading copy of a Markdown record, kept with it and tracked.
!docs/appnotes/sources/**/*-GENERATED.pdf
# The keyboard reproduction of the rounding bugs is read as a PDF beside its .ltx, kept with it and tracked.
!docs/appnotes/sources/AN0017_Display_Formats/rounding-audit/bugFix.pdf
# Python byte-cache from running the docs tools and the docs/refdb47 checkers in place
docs/**/__pycache__/

# tools/pgemu screen captures
tools/pgemu/out*/
tools/pgemu/__pycache__/
tools/pgemu/.stubs-cache/
tools/pgemu/fs/

# What the calculator creates for itself in whatever folder --fs maps, so a tools/hwtest kit runs in place. PROGRAMS is absent on purpose: its contents are kept.
tools/hwtest/**/DATA/
tools/hwtest/**/LIBRARY/
tools/hwtest/**/PGEMU/
tools/hwtest/**/SAVFILES/
tools/hwtest/**/STATE/

# rejig built with the C47 items upstream does not have yet, macOS and Windows; tracked
!tools/rejig_patched/
!tools/rejig_patched/rejig
!tools/rejig_patched/rejig.exe
